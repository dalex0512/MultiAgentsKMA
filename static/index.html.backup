<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>KMA Chatbot</title>
<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  body { font-family: 'Segoe UI', Arial, sans-serif; font-size: 13px; background: #f0f2f5; color: #1a1a1a; height: 100vh; display: flex; flex-direction: column; }

  header { background: #0a2540; color: #fff; padding: 8px 16px; display: flex; align-items: center; gap: 12px; flex-shrink: 0; }
  header h1 { font-size: 15px; font-weight: 600; letter-spacing: 0.3px; }
  header span { font-size: 11px; color: #94a3b8; }

  .main { display: flex; flex: 1; overflow: hidden; gap: 1px; background: #d1d5db; }

  .chat-panel { flex: 1; display: flex; flex-direction: column; background: #fff; min-width: 0; }
  .messages { flex: 1; overflow-y: auto; padding: 12px 16px; display: flex; flex-direction: column; gap: 8px; }

  .welcome { display: flex; flex-direction: column; align-items: center; justify-content: center; flex: 1; gap: 20px; padding: 24px 16px; }
  .welcome-title { font-size: 20px; font-weight: 600; color: #0a2540; }
  .welcome-sub { font-size: 13px; color: #64748b; }
  .examples-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; width: 100%; max-width: 560px; }
  .example-card { background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 10px 13px; cursor: pointer; text-align: left; font-size: 12px; color: #1a1a1a; line-height: 1.45; transition: border-color 0.15s, background 0.15s; }
  .example-card:hover { border-color: #0a2540; background: #f0f5ff; }
  .example-card .card-label { font-size: 10px; color: #64748b; margin-bottom: 3px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.4px; }

  .msg { max-width: 82%; padding: 8px 11px; border-radius: 6px; line-height: 1.5; word-break: break-word; }
  .msg.user { align-self: flex-end; background: #0a2540; color: #fff; white-space: pre-wrap; }
  .msg.thinking { align-self: flex-start; background: #f8fafc; color: #94a3b8; border: 1px dashed #cbd5e1; font-style: italic; white-space: pre-wrap; }
  .msg.bot { align-self: flex-start; background: #f1f5f9; color: #1a1a1a; border: 1px solid #e2e8f0; }

  .msg.bot h1, .msg.bot h2, .msg.bot h3 { font-size: 13px; font-weight: 700; color: #0a2540; margin: 8px 0 3px; }
  .msg.bot h1:first-child, .msg.bot h2:first-child, .msg.bot h3:first-child { margin-top: 0; }
  .msg.bot p { margin: 4px 0; }
  .msg.bot p:first-child { margin-top: 0; }
  .msg.bot p:last-child { margin-bottom: 0; }
  .msg.bot ul, .msg.bot ol { padding-left: 18px; margin: 4px 0; }
  .msg.bot li { margin: 2px 0; }
  .msg.bot strong { color: #0a2540; }
  .msg.bot hr { border: none; border-top: 1px solid #e2e8f0; margin: 6px 0; }

  .msg.bot .meta { font-size: 10px; color: #64748b; margin-top: 7px; padding-top: 5px; border-top: 1px solid #e2e8f0; display: flex; gap: 10px; flex-wrap: wrap; }
  .msg.bot .meta b { color: #0a2540; }

  .input-row { padding: 8px 12px; border-top: 1px solid #e2e8f0; display: flex; gap: 6px; background: #fff; }
  .input-row textarea { flex: 1; resize: none; border: 1px solid #cbd5e1; border-radius: 4px; padding: 6px 8px; font-size: 13px; font-family: inherit; outline: none; height: 36px; overflow: hidden; }
  .input-row textarea:focus { border-color: #0a2540; }
  .input-row button { background: #0a2540; color: #fff; border: none; border-radius: 4px; padding: 0 14px; font-size: 13px; cursor: pointer; white-space: nowrap; }
  .input-row button:hover { background: #0f3460; }
  .input-row button:disabled { background: #94a3b8; cursor: not-allowed; }

  .info-panel { width: 240px; background: #fff; display: flex; flex-direction: column; overflow-y: auto; flex-shrink: 0; }
  .info-section { padding: 10px 12px; border-bottom: 1px solid #e2e8f0; }
  .info-section h3 { font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; color: #64748b; margin-bottom: 6px; }

  .stat-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 4px; }
  .stat { background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 3px; padding: 5px 7px; }
  .stat .label { font-size: 10px; color: #64748b; }
  .stat .value { font-size: 13px; font-weight: 600; color: #0a2540; margin-top: 1px; }

  .pipeline-badge { display: inline-block; padding: 2px 8px; border-radius: 3px; font-size: 11px; font-weight: 600; }
  .pipeline-badge.native_rag  { background: #dcfce7; color: #166534; }
  .pipeline-badge.hybrid_rag  { background: #fef9c3; color: #854d0e; }
  .pipeline-badge.agentic_rag { background: #fee2e2; color: #991b1b; }

  .sources-list { display: flex; flex-direction: column; gap: 4px; }
  .source-item { background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 3px; padding: 5px 7px; font-size: 11px; transition: border-color 0.15s, background 0.15s; }
  .source-item:hover { border-color: #0a2540; background: #f0f5ff; }
  .source-item a { display: block; font-weight: 600; color: #0a2540; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; text-decoration: none; }
  .source-item a:hover { text-decoration: underline; }
  .source-item .src-meta { color: #64748b; margin-top: 1px; }

  .no-data { color: #94a3b8; font-size: 11px; font-style: italic; }

  ::-webkit-scrollbar { width: 4px; }
  ::-webkit-scrollbar-track { background: transparent; }
  ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 2px; }
</style>
</head>
<body>

<header>
  <h1>KMA Chatbot</h1>
  <span>Hybrid Multi-Agent RAG — Học viện Kỹ thuật Mật mã</span>
</header>

<div class="main">
  <div class="chat-panel">
    <div class="messages" id="messages">
      <div class="welcome" id="welcome">
        <div class="welcome-title">Xin chào! Tôi có thể giúp gì cho bạn?</div>
        <div class="welcome-sub">Hỏi bất cứ điều gì về Học viện Kỹ thuật Mật mã (KMA)</div>
        <div class="examples-grid">
          <button class="example-card" onclick="useExample(this)">
            <div class="card-label">Tuyển sinh</div>
            KMA tuyển sinh ngành gì năm 2025 và chỉ tiêu là bao nhiêu?
          </button>
          <button class="example-card" onclick="useExample(this)">
            <div class="card-label">Ngoại ngữ</div>
            Chuẩn đầu ra tiếng Anh của KMA là gì? Có thể dùng chứng chỉ nào?
          </button>
          <button class="example-card" onclick="useExample(this)">
            <div class="card-label">Trúng tuyển</div>
            Danh sách trúng tuyển thạc sĩ An toàn thông tin năm 2025 gồm những ai?
          </button>
          <button class="example-card" onclick="useExample(this)">
            <div class="card-label">Tốt nghiệp</div>
            Quy trình và điều kiện thi tốt nghiệp online tại KMA là gì?
          </button>
          <button class="example-card" onclick="useExample(this)">
            <div class="card-label">Đề thi</div>
            Ma trận đề thi môn Tin học đại cương gồm những nội dung gì?
          </button>
          <button class="example-card" onclick="useExample(this)">
            <div class="card-label">So sánh</div>
            So sánh điều kiện xét tuyển ngành An toàn thông tin và Công nghệ thông tin tại KMA 2025
          </button>
        </div>
      </div>
    </div>
    <div class="input-row">
      <textarea id="input" placeholder="Nhập câu hỏi về KMA..." rows="1"></textarea>
      <button id="send-btn" onclick="sendMessage()">Gửi</button>
    </div>
  </div>

  <div class="info-panel">
    <div class="info-section">
      <h3>Pipeline</h3>
      <div id="pipeline-info"><span class="no-data">Chưa có câu hỏi</span></div>
    </div>
    <div class="info-section">
      <h3>Thời gian</h3>
      <div class="stat-grid">
        <div class="stat"><div class="label">Tổng</div><div class="value" id="t-total">—</div></div>
        <div class="stat"><div class="label">Retrieval</div><div class="value" id="t-retrieval">—</div></div>
        <div class="stat"><div class="label">LLM</div><div class="value" id="t-llm">—</div></div>
        <div class="stat"><div class="label">Vòng lặp</div><div class="value" id="n-rounds">—</div></div>
      </div>
    </div>
    <div class="info-section">
      <h3>Độ phức tạp (Qc)</h3>
      <div class="stat-grid">
        <div class="stat" style="grid-column:span 2">
          <div class="label">Điểm Qc</div>
          <div class="value" id="qc-score">—</div>
        </div>
      </div>
    </div>
    <div class="info-section" style="flex:1">
      <h3>Nguồn tài liệu</h3>
      <div class="sources-list" id="sources-list"><span class="no-data">Chưa có</span></div>
    </div>
  </div>
</div>

<script>
  marked.use({ breaks: true, gfm: true });

  const messagesEl = document.getElementById('messages');
  const inputEl    = document.getElementById('input');
  const sendBtn    = document.getElementById('send-btn');

  inputEl.addEventListener('keydown', e => {
    if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); sendMessage(); }
  });

  function useExample(btn) {
    const text = btn.innerText.replace(btn.querySelector('.card-label').innerText, '').trim();
    inputEl.value = text;
    inputEl.focus();
    sendMessage();
  }

  function hideWelcome() {
    const w = document.getElementById('welcome');
    if (w) w.remove();
  }

  function createMessage(role) {
    hideWelcome();
    const div = document.createElement('div');
    div.className = 'msg ' + role;
    messagesEl.appendChild(div);
    messagesEl.scrollTop = messagesEl.scrollHeight;
    return div;
  }

  function renderBotContent(div, text) {
    let content = div.querySelector('.bot-content');
    if (!content) {
      content = document.createElement('div');
      content.className = 'bot-content';
      div.insertBefore(content, div.querySelector('.meta'));
    }
    content.innerHTML = marked.parse(text);
    messagesEl.scrollTop = messagesEl.scrollHeight;
  }

  function addMeta(div, pipeline, qc, t_total, n_rounds) {
    let m = div.querySelector('.meta');
    if (!m) {
      m = document.createElement('div');
      m.className = 'meta';
      div.appendChild(m);
    }
    m.innerHTML = `<b>Pipeline:</b> ${pipeline} &nbsp; <b>Qc:</b> ${qc} &nbsp; <b>T:</b> ${t_total}s &nbsp; <b>Vòng:</b> ${n_rounds}`;
  }

  function updatePipelineBadge(pipeline, qc) {
    const badges = { native_rag: 'Native RAG', hybrid_rag: 'Hybrid RAG', agentic_rag: 'Agentic RAG' };
    document.getElementById('pipeline-info').innerHTML =
      `<span class="pipeline-badge ${pipeline}">${badges[pipeline] || pipeline}</span>`;
    document.getElementById('qc-score').textContent = qc + ' / 1.0';
  }

  function updateSources(sources, t_retrieval) {
    document.getElementById('t-retrieval').textContent = t_retrieval + 's';
    const srcEl = document.getElementById('sources-list');
    if (!sources || sources.length === 0) {
      srcEl.innerHTML = '<span class="no-data">Không có nguồn</span>';
      return;
    }
    srcEl.innerHTML = sources.map(s =>
      `<div class="source-item">
        <a href="/docs/${encodeURIComponent(s.source)}" target="_blank" title="${s.source}">${s.source}</a>
        <div class="src-meta">Trang ${s.page} &nbsp;|&nbsp; Điểm: ${s.score}</div>
      </div>`
    ).join('');
  }

  function updateTiming(t_total, t_llm, n_rounds) {
    document.getElementById('t-total').textContent = t_total + 's';
    document.getElementById('t-llm').textContent   = t_llm + 's';
    document.getElementById('n-rounds').textContent = n_rounds;
  }

  async function sendMessage() {
    const question = inputEl.value.trim();
    if (!question) return;

    inputEl.value = '';
    inputEl.style.height = '36px';
    sendBtn.disabled = true;

    const userDiv    = createMessage('user');
    userDiv.textContent = question;

    const thinkingDiv = createMessage('thinking');
    thinkingDiv.textContent = 'Đang xử lý...';

    let botDiv    = null;
    let fullText  = '';
    let pipeline  = '';
    let qc        = 0;
    let buffer    = '';

    try {
      const res = await fetch('/chat/stream', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ question }),
      });

      const reader  = res.body.getReader();
      const decoder = new TextDecoder();

      while (true) {
        const { done, value } = await reader.read();
        if (done) break;

        buffer += decoder.decode(value, { stream: true });
        const lines = buffer.split('\n');
        buffer = lines.pop();

        for (const line of lines) {
          if (!line.startsWith('data: ')) continue;
          const raw = line.slice(6).trim();
          if (raw === '[DONE]') continue;

          let ev;
          try { ev = JSON.parse(raw); } catch { continue; }

          if (ev.type === 'start') {
            pipeline = ev.pipeline;
            qc       = ev.qc;
            updatePipelineBadge(pipeline, qc);

          } else if (ev.type === 'info') {
            thinkingDiv.remove();
            updateSources(ev.sources, ev.t_retrieval);
            botDiv = createMessage('bot');

          } else if (ev.type === 'delta') {
            if (thinkingDiv.isConnected) thinkingDiv.remove();
            if (!botDiv) botDiv = createMessage('bot');
            fullText += ev.content;
            renderBotContent(botDiv, fullText);

          } else if (ev.type === 'done') {
            updateTiming(ev.t_total, ev.t_llm, ev.n_rounds);
            if (botDiv) addMeta(botDiv, pipeline, qc, ev.t_total, ev.n_rounds);
          }
        }
      }
    } catch (err) {
      if (thinkingDiv.isConnected) thinkingDiv.remove();
      if (!botDiv) botDiv = createMessage('bot');
      renderBotContent(botDiv, 'Lỗi kết nối đến máy chủ. Vui lòng thử lại.');
    }

    sendBtn.disabled = false;
    inputEl.focus();
  }
</script>
</body>
</html>
