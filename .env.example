OPENAI_API_KEY=sk-...
QDRANT_URL=https://xxxx.qdrant.io
QDRANT_API_KEY=...

# Chat qua 9router (hoặc OpenAI trực tiếp nếu không set BASE_URL):
# OPENAI_BASE_URL=http://127.0.0.1:20128/v1
# LLM_MODEL=cx/gpt-5.3-codex-low

# Embedding trực tiếp OpenAI — không qua 9router (bắt buộc nếu Codex xoay không embed):
OPENAI_EMBED_API_KEY=sk-proj-...
# OPENAI_EMBED_BASE_URL=https://api.openai.com/v1

# Độ chính xác tối đa cho mọi agent (mặc định BẬT — không cần ghi nếu giữ mặc định):
# KMA_ACCURACY_MODE=1
#   → TOP_K=12, Router Qc (0.40/0.65), leo Agentic khi retrieve yếu / không tìm thấy

# Chỉ bật khi demo nhanh (TẮT accuracy):
# KMA_FAST_MODE=1

# Qc cục bộ (spaCy + entropy) — mặc định BẬT; tắt để dùng LLM complexity cũ:
# KMA_USE_LOCAL_QC=1
# KMA_LOAD_ROUTER=1
# KMA_TEXT_NORM=1
# KMA_MAX_ACTIVE_CHATS=500
# KMA_QC_PREFETCH_TOP_K=5

# Session nóng Redis (tùy chọn — không có REDIS_URL thì dùng RAM):
# REDIS_URL=redis://127.0.0.1:6379/0
# KMA_SESSION_BACKEND=redis
# KMA_SESSION_HOT_TTL_SEC=7200
# KMA_SESSION_COLD_IDLE_SEC=3600
# KMA_HISTORY_HOT_MAX=6

# Parent–Child chunking (ingest + retrieve) — tuyen_sinh,khao_thi,ma_tran
# KMA_PARENT_CHILD_INGEST=1
# KMA_PARENT_CHILD_AGENTS=tuyen_sinh,khao_thi,ma_tran
# KMA_PARENT_CHUNK_CHARS=1500
# KMA_CHILD_CHUNK_CHARS=200
# KMA_PARENT_SEARCH_POOL=4
# KMA_PARENT_RETRIEVE_MAX=6

# Metadata-rich tables (ý tưởng 7) — diem_thi, ma_tran PDF
# KMA_TABLE_METADATA_INGEST=1
# KMA_TABLE_METADATA_AGENTS=diem_thi,ma_tran
# KMA_TABLE_MAX_ROWS=35
# pip install pdfplumber && python ingest_all.py --domain diem_thi
# Sau khi bật: chạy lại python ingest_all.py

# Document Relevance Grader — Corrective RAG (ý tưởng 6)
# KMA_RELEVANCE_GRADER=1
# KMA_GRADER_MAX_REQUERY=1
# KMA_GRADER_MAX_CHUNKS=5
# KMA_GRADER_EXCERPT_CHARS=480

# PostgreSQL (admin login)
DATABASE_URL=postgresql://kma_app:YOUR_PASSWORD@localhost:5432/kma_rag
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# OTP admin — gửi email Gmail (App Password, không dùng mật khẩu đăng nhập thường)
# KMA_OTP_DEV_LOG=0
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your@gmail.com
SMTP_PASSWORD=your_gmail_app_password
OTP_EXPIRE_MINUTES=10
OTP_LENGTH=6
OTP_RESEND_COOLDOWN_SECONDS=60
PENDING_LOGIN_EXPIRE_MINUTES=15

# Đăng ký API công khai (mặc định tắt — tạo admin bằng create_admin_account.py)
# ALLOW_PUBLIC_REGISTER=0

# Rate limit auth (mỗi process, in-memory)
# AUTH_LOGIN_MAX_ATTEMPTS=10
# AUTH_LOGIN_WINDOW_SEC=900
# AUTH_OTP_SEND_MAX=5
# AUTH_OTP_SEND_WINDOW_SEC=900
# ADMIN_MAX_UPLOAD_MB=50
# ADMIN_UPLOAD_MAX_PER_HOUR=20
# ADMIN_BENCHMARK_MAX_CASES=10
# REFRESH_TOKEN_EXPIRE_DAYS=7
# CLAMAV_ENABLED=0
# CLAMAV_BIN=clamscan
# METRICS_ENABLED=1

# Google SSO (tùy chọn)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback
# GOOGLE_ALLOWED_EMAIL_DOMAIN=actvn.edu.vn

# LDAP (tùy chọn)
# LDAP_ENABLED=0
# LDAP_SERVER=ldap://ldap.example.com
# LDAP_PORT=389
# LDAP_BIND_DN=cn=admin,dc=example,dc=com
# LDAP_BIND_PASSWORD=
# LDAP_USER_BASE=ou=users,dc=example,dc=com
# LDAP_USER_FILTER=(uid={username})
